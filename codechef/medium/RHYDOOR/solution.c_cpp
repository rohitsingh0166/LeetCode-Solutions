#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n;
	    string s;
	    cin>>n>>s;
	    int count=0, ans=0;
	    char last= ' ';
	    for(int i=0; i<n; i++){
	        if(s[i]==last){
	            count ++;
	            
	        }else{
	            last=s[i];
	            count=1;
	        }
	        if(count==3){
	            ans++;
	            count=0;
	            last=' ';
	        }
	        
	    }
	    cout<<ans<<endl;
	}
	return 0;

}
