#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n;
	    cin>>n;
	    vector<long long>a(n);
	    for(int i=0; i<n;i++){
	        cin>>a[i];
	    }
	    int ans=0;
	    for(int i=0;i<n; i++){
	        int score=0;
	        for(int j=0; j<n-1; j++){
	            long long x=a[j]+(j>=i?1:0);
	           // long long y=a[j+1]+(j+1>=i1:0);
	           if(x==y) score++;
	        }
	        ans=max(ans,score);
	    }
	    cout<<ans<<endl;
	}
return 0;
}
