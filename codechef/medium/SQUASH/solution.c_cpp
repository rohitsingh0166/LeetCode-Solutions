#include <bits/stdc++.h>
using namespace std;

int main() {
	int t;
	cin>>t;
	while(t--){
	    int n,k;
	    string s;
	    cin>>n>>k;
	    cin>>s;
	    int groups=1;
	    for(int i=1;i<n;i++){
	        if(s[i]!=s[i-1]){
	            groups++;
	        }
	    }
	    if(k>=groups){
	        cout<<"YES"<<endl;
	    }else{
	        cout<<"NO"<<endl;
	    }
	    return 0;
	}

}
