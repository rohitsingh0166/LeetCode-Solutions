#include <bits/stdc++.h>
using namespace std;

int main() {
    int t;
    cin>>t;
    while(t--){
        int n;
        cin>>n;
        vector<int>a(n);
        int total=0;
        for(int i=0;i<n; i++){
            cin>>a[i];
            total +=a[i];
        }
        int minsum=a[0]+a[1];
        for(int i=1;i<n-1;i++){
            minsum=min(minsum,a[i]+a[i+1]);
        }
        cout<<total-minsum/2<<endl;
    }
    return 0;
}
