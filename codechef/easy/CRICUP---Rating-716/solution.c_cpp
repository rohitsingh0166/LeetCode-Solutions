#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin>>t;
    while (t--) {
        int x, y;
        cin >> x >> y;
        int d;
        cin >> d;
        if (abs((x - y)) <= d){
            cout << "YES" << endl;
        } else {
            cout << "NO" << endl;
        }
    }
    return 0;
}