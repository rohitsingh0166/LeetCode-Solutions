#include <bits/stdc++.h>

using namespace std;

int main() {
    int t;
    cin >> t;
    while (t--) {
        int n, a, b;
        cin >> n >> a >> b;
        if (n <= 1) {
            cout << 1 * a + 0 * b << endl;
        } else {
            cout << n / 2 * a + n / 2 * b << endl;
        }

    }
    return 0;
}